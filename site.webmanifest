{
  "name": "WebToolVault – Free Online File Converters & Tools",
  "short_name": "WebToolVault",
  "description": "Convert, resize and compress files right in your browser. No sign-up, no ads, no uploads.",
  "start_url": "/index.html",
  "scope": "/",
